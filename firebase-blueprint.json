{
  "entities": {
    "Song": {
      "title": "Song",
      "description": "A song track stored in the database.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "audioUrl": { "type": "string" },
        "coverImage": { "type": "string" },
        "plays": { "type": "number" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "artist", "audioUrl", "coverImage", "plays", "slug", "description", "userId", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized admin users",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    },
    "News": {
      "title": "News",
      "description": "News article",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "content": { "type": "string" },
        "featuredImage": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["headline", "content", "featuredImage", "userId", "createdAt", "updatedAt"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Artist profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "biography": { "type": "string" },
        "photoUrl": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "biography", "photoUrl", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "songs/{songId}": {
      "schema": { "$ref": "#/entities/Song" },
      "description": "Collection of songs available for streaming"
    },
    "admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Collection of admins"
    },
    "news/{newsId}": {
      "schema": { "$ref": "#/entities/News" },
      "description": "Collection of news posts"
    },
    "artists/{artistId}": {
      "schema": { "$ref": "#/entities/Artist" },
      "description": "Collection of artists"
    }
  }
}
